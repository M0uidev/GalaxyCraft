{
	"schemaVersion": 1,
	"id": "galaxycraft",
	"version": "${version}",
	"name": "Super Minecraft Galaxy",
	"description": "Minecraft survival inside Super Mario Galaxy 2 (Dolphin): round, destructible planets.",
	"authors": ["M0uiDev"],
	"contact": {
		"homepage": "https://discord.gg/NhKmT6cVM7",
		"sources": "https://github.com/M0uidev/GalaxyCraft",
		"issues": "https://github.com/M0uidev/GalaxyCraft/issues",
		"youtube": "https://www.youtube.com/@m0uidev"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.moui.galaxycraft.GalaxyCraft"],
		"client": ["dev.moui.galaxycraft.client.GalaxyCraftClient"]
	},
	"mixins": [
		"galaxycraft.mixins.json",
		{"config": "galaxycraft.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
