+  // While Minecraft owns keyboard and mouse, the XInput2 backend feeds it (GalaxyCraft::OnXInput2)
+  // and keeps the pointer centred; here the events only need to stay away from Dolphin's UI.
+  const bool active = GalaxyCraft::InputActive();
