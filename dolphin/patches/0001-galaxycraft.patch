+void KeyboardMouse::CaptureForGalaxyCraft(bool capture)
+{
+  if (capture != m_galaxycraft_capture)
+  {
+    m_galaxycraft_capture = capture;
+    if (capture)
+    {
+      if (!m_blank_cursor)
+      {
+        // An all-transparent cursor: with the cursor hidden, Xwayland turns the warps below into
+        // pointer locking, so motion keeps coming at the screen edges.
+        char none = 0;
+        XColor black{};
+        const Pixmap pixmap = XCreateBitmapFromData(m_display, m_window, &none, 1, 1);
+        m_blank_cursor = XCreatePixmapCursor(m_display, pixmap, pixmap, &black, &black, 0, 0);
+        XFreePixmap(m_display, pixmap);
+      }
+      XDefineCursor(m_display, m_window, m_blank_cursor);
+    }
+    else
+    {
+      XUndefineCursor(m_display, m_window);
+    }
+    XFlush(m_display);
+  }
+  if (capture)
+  {
+    XWindowAttributes attribs;
+    XGetWindowAttributes(m_display, m_window, &attribs);
+    XWarpPointer(m_display, None, m_window, 0, 0, 0, 0, attribs.width / 2, attribs.height / 2);
+    XFlush(m_display);
+  }
+}
