+u32 s_xinput_buttons = 0;  // under s_mutex
+bool s_f11_held = false;    // under s_mutex
+std::atomic<bool> s_fullscreen_requested{false};
+
+// The Wii Remote state Mario mode reports, read by the input override (CPU thread, under the
+// controllers' state lock) and written once per field. Its own mutex: the override must never
+// wait on s_mutex, which the field hook holds while it takes the state lock.
+std::mutex s_pad_mutex;
+gxc::WiimoteState s_pad;
+
+std::optional<ControlState> OverrideInput(std::string_view group, std::string_view control,
+                                          ControlState)
+{
+  gxc::WiimoteState pad;
+  {
+    std::lock_guard lock(s_pad_mutex);
+    pad = s_pad;
+  }
+  if (group == "Buttons")
+  {
+    const std::pair<std::string_view, bool> buttons[] = {
+        {"A", pad.a},   {"B", pad.b}, {"-", pad.minus}, {"+", pad.plus}, {"Home", pad.home},
+        {"1", pad.one}, {"2", pad.two}, {"C", pad.c},   {"Z", pad.z}};
+    for (const auto& [name, down] : buttons)
+      if (control == name)
+        return down ? 1.0 : 0.0;
+  }
+  if (group == "Stick" && (control == "X" || control == "Y"))
+    return control == "X" ? pad.stick_x : pad.stick_y;
+  if (group == "IR" && (control == "X" || control == "Y") && pad.center_ir)
+    return control == "X" ? 0.0 : gxc::MarioInput::CENTER_IR_Y;
+  if (group == "Shake")
+    return pad.shake ? 1.0 : 0.0;
+  return std::nullopt;
+}
+
+// Wii Remote 1 and its Nunchuk (CPU thread, which is where they are read).
+void SetWiimoteOverride(bool on)
+{
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  auto* wiimote = static_cast<WiimoteEmu::Wiimote*>(Wiimote::GetConfig()->GetController(0));
+  auto* attachments = static_cast<ControllerEmu::Attachments*>(
+      wiimote->GetWiimoteGroup(WiimoteEmu::WiimoteGroup::Attachments));
+  auto& nunchuk = attachments->GetAttachmentList()[WiimoteEmu::ExtensionNumber::NUNCHUK];
+  if (on)
+  {
+    wiimote->SetInputOverrideFunction(OverrideInput);
+    nunchuk->SetInputOverrideFunction(OverrideInput);
+  }
+  else
+  {
+    wiimote->ClearInputOverrideFunction();
+    nunchuk->ClearInputOverrideFunction();
+  }
+}
+
+struct State
+{
+  std::unique_ptr<gxc::Shm> shm;
+  std::unique_ptr<gxc::HostBridge> bridge;
+  std::unique_ptr<gxc::InputWriter> input;
+  std::unique_ptr<DolphinGuestMemory> memory;
+  Common::EventHook field_hook;
+  gxc::MarioInput mario;
+  bool override_on = false;
+  bool link_shown = true;  // the bridge's Minecraft mode as last announced
+  bool muted = false;      // the game's sound off while Minecraft's menus show (InMenu)
+  u8 keys[64] = {};  // keyboard and mouse as of the last input update (Escape included)
+  u32 buttons = 0;
+  std::optional<std::pair<std::array<u8, 64>, u32>> dev_keys;  // ctl keys, while set
+  u32 logged_mod_pid = 0;  // NoteHeartbeat: the Minecraft last logged
+};
+
+// ctl keys: hold these (names as DevKeysToInput) until the next keys; none = back to the
+// keyboard and mouse.
+void SetDevKeys(State& state, const std::string& names)
+{
+  std::array<u8, 64> keys{};
+  u32 buttons = 0;
+  gxc::DevKeysToInput(names, keys.data(), buttons);
+  if (names.empty())
+    state.dev_keys.reset();
+  else
+    state.dev_keys.emplace(keys, buttons);
+  // The mouse buttons reach Minecraft too (a probe holding the attack button on a block).
+  if (state.input)
+    state.input->Buttons(names.empty() ? s_xinput_buttons : buttons);
+}
+
+// Field hook, after Tick: Mario mode's Wii Remote follows keyboard and mouse while following;
+// in Minecraft's menus it is held neutral (no other controller reaches the game).
+void UpdateMarioInput(State& state)
+{
+  const bool following = state.bridge->Following();
+  const bool override = following || state.bridge->InMenu();
+  if (override != state.override_on)
+  {
+    state.mario.Reset();
+    SetWiimoteOverride(override);
+    state.override_on = override;
+  }
+  gxc::WiimoteState pad;
+  if (following)
+  {
+    // With a Minecraft screen open (the chat) the keyboard and mouse type there, and while the
+    // player flies (/fly) or walks by Minecraft's movement they move it: Mario stays put, or goes
+    // where the player is.
+    static const u8 none[64] = {};
+    const bool screen =
+        state.bridge->ScreenOpen() || state.bridge->Flying() || state.bridge->Walking();
+    const u8* keys = state.dev_keys ? state.dev_keys->first.data() : screen ? none : state.keys;
+    const u32 buttons = state.dev_keys ? state.dev_keys->second : screen ? 0u : state.buttons;
+    pad = state.mario.Update(keys, buttons, state.bridge->Playing(), state.bridge->GalaxyView(),
+                             state.bridge->ItemActive(), state.bridge->McFeel());
+    state.bridge->SetGait(pad.sprint, pad.sneak, pad.walking);
+    // Minecraft's pause menu opens SMG2's own: the mod holds + for a few frames.
+    pad.plus = pad.plus || state.bridge->PlusHeld();
+  }
+  std::lock_guard lock(s_pad_mutex);
+  s_pad = pad;
+}
+
+// Field hook: the game is silent while Minecraft's menus cover it (its own sound plays there),
+// and while a world is entered behind Minecraft's screen, until the zoom from space.
+void UpdateMute(State& state)
+{
+  const bool mute = state.bridge->Silent();
+  if (mute == state.muted)
+    return;
+  state.muted = mute;
+  Core::QueueHostJob([mute](Core::System& system) {
+    if (SoundStream* stream = system.GetSoundStream())
+      stream->SetVolume(mute || Config::Get(Config::MAIN_AUDIO_MUTED) ? 0 : Config::Get(Config::MAIN_AUDIO_VOLUME));
+  });
+}
