+// Emulated RAM through raw pointers with our own bounds checks: the game hands us addresses
+// (e.g. KCL data), and a bad one must be ignored rather than raise Dolphin's panic alerts.
+class DolphinGuestMemory final : public gxc::GuestMemory
+{
+public:
+  explicit DolphinGuestMemory(Memory::MemoryManager& mm) : m_mm(mm) {}
+
+  bool Read(u32 addr, void* dst, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(dst, p, n);
+    return true;
+  }
+
+  bool Write(u32 addr, const void* src, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(p, src, n);
+    return true;
+  }
+
+  std::vector<std::pair<u32, u32>> Regions() override
+  {
+    std::vector<std::pair<u32, u32>> out{{0x80000000u, m_mm.GetRamSizeReal()}};
+    if (m_mm.GetEXRAM())
+      out.emplace_back(0x90000000u, m_mm.GetExRamSizeReal());
+    return out;
+  }
+
+private:
+  u8* Ptr(u32 addr, u32 n)
+  {
+    const u32 base = addr & 0xF0000000u;
+    const u32 off = addr & 0x0FFFFFFFu;
+    if ((base == 0x80000000u || base == 0xC0000000u) &&
+        static_cast<u64>(off) + n <= m_mm.GetRamSizeReal())
+      return m_mm.GetRAM() + off;
+    if ((base == 0x90000000u || base == 0xD0000000u) && m_mm.GetEXRAM() &&
+        static_cast<u64>(off) + n <= m_mm.GetExRamSizeReal())
+      return m_mm.GetEXRAM() + off;
+    return nullptr;
+  }
+
+  Memory::MemoryManager& m_mm;
+};
