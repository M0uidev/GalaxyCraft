+
+void Start(Core::System& system)
+{
+  const char* env = std::getenv("GALAXYCRAFT");
+  if (!env || std::strcmp(env, "1") != 0)
+    return;
+
+  // The log of this run, in Dolphin's Logs folder (with the launcher: galaxycraft/dolphin/Logs).
+  {
+    std::lock_guard lock(s_log_mutex);
+    s_log_path = File::GetUserPath(D_LOGS_IDX) + "galaxycraft.log";
+    File::CreateFullPath(s_log_path);
+    File::IOFile(s_log_path, "wb");
+  }
+  const std::string shm_path = gxc::ShmFile(std::string(GXC_SHM_NAME).substr(1));  // no leading /
+  auto state = std::make_unique<State>();
+  state->shm = gxc::Shm::Create(shm_path);
+  if (!state->shm)
+  {
+    ERROR_LOG_FMT(CORE, "GalaxyCraft: could not create {}", shm_path);
+    Log("could not create " + shm_path);
+    return;
+  }
+  state->bridge = std::make_unique<gxc::HostBridge>(*state->shm, NowMs);
+  // Start on the Wii Remote (menus), the player links with the hotkey in a level.
+  if (const char* unlinked = std::getenv("GALAXYCRAFT_START_UNLINKED"); unlinked && *unlinked == '1')
+    state->bridge->SetMinecraftMode(false);
+  // The Wii Remote on the title and file select, Minecraft once a save is picked.
+  if (const char* on_save = std::getenv("GALAXYCRAFT_LINK_ON_SAVE"); on_save && *on_save == '1')
+    state->bridge->SetLinkOnSave(true);
+  // tools/gxplay.sh: the game boots by itself into GalaxyCraftSpace behind Minecraft's menus.
+  if (const char* boot = std::getenv("GALAXYCRAFT_BOOT"); boot && std::strcmp(boot, "space") == 0)
+    state->bridge->SetBootSpace(true);
+  state->link_shown = state->bridge->MinecraftMode();
+  state->input = std::make_unique<gxc::InputWriter>(*state->shm);
+  state->memory = std::make_unique<DolphinGuestMemory>(system.GetMemory());
+  // Runs on the CPU thread at the end of every video field: emulated RAM is safe to touch.
+  state->field_hook = system.GetVideoEvents().vi_end_field_event.Register([] {
+    std::lock_guard lock(s_mutex);
+    if (!s_state)
+      return;
+    s_state->bridge->Tick(*s_state->memory);
+    RunControlFile(*s_state->memory, *s_state->bridge, ModAlive(*s_state->shm), *s_state);
+    NoteHeartbeat(*s_state);
+    AnnounceLink(*s_state);
+    UpdateMarioInput(*s_state);
+    UpdateMute(*s_state);
+  });
+
+  std::lock_guard lock(s_mutex);
+  s_state = std::move(state);
+  s_running = true;
+  NOTICE_LOG_FMT(CORE, "GalaxyCraft: bridge running on {}", shm_path);
+  Log("bridge running on " + shm_path);
+}
+
+void Stop()
+{
+  std::unique_ptr<State> state;
+  {
+    std::lock_guard lock(s_mutex);
+    state = std::move(s_state);
+  }
+  s_running = false;
+  if (state && state->override_on)
+    SetWiimoteOverride(false);
+  // Destroying the hook here (outside the lock) waits for nothing: the hook takes s_mutex and
+  // sees s_state == nullptr if it runs concurrently.
+}
+
+bool OnInvalidAccess(u32 address, u32 pc, u32 lr, bool write)
+{
+  if (!s_running.load(std::memory_order_relaxed))
+    return false;
+  // The first time from each PC and every 1000th after: enough to find it, not a flood.
+  static std::mutex mutex;
+  static std::array<std::pair<u32, u64>, 64> seen{};
+  u64 count = 0;
+  {
+    std::lock_guard lock(mutex);
+    for (auto& [at, n] : seen)
+      if (at == pc || n == 0)
+      {
+        at = pc;
+        count = ++n;
+        break;
+      }
+  }
+  if (count == 1 || (count != 0 && count % 1000 == 0))  // 0: 64 PCs logged already
+  {
+    // The callers up the guest stack (each frame's back chain word, and the LR saved above it).
+    std::string callers;
+    {
+      auto& system = Core::System::GetInstance();
+      auto& memory = system.GetMemory();
+      auto read = [&](u32 addr) -> std::optional<u32> {
+        // MEM1 (0x80000000..) only: the game's stacks are there.
+        if (addr < 0x80000000 || addr + 4 > 0x80000000 + memory.GetRamSizeReal())
+          return std::nullopt;
+        return memory.Read_U32(addr & 0x7fffffff); // physical
+      };
+      u32 sp = system.GetPPCState().gpr[1];
+      for (int i = 0; i < 10; i++)
+      {
+        const auto back = read(sp);
+        if (!back || *back <= sp)
+          break;
+        const auto ret = read(*back + 4);
+        if (!ret)
+          break;
+        callers += fmt::format(" {:08x}", *ret);
+        sp = *back;
+      }
+    }
+    WARN_LOG_FMT(CORE, "GalaxyCraft: invalid {} {:#010x}, PC = {:#010x}, LR = {:#010x} ({} times)",
+                 write ? "write to" : "read from", address, pc, lr, count);
+    Log(fmt::format("invalid {} {:#010x}, PC = {:#010x}, LR = {:#010x} ({} times), callers:{}",
+                    write ? "write to" : "read from", address, pc, lr, count, callers));
+  }
+  return true;
+}
+
+bool SavestatesAllowed()
+{
+  return t_dev_savestate;
+}
+
+void OnStateLoaded()
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->bridge->OnStateLoaded();
+}
+
+bool InputActive()
+{
+  std::lock_guard lock(s_mutex);
+  return s_state && MinecraftHasInput(*s_state);
+}
+
+// Minecraft turns with the mouse: playing in its view, no Minecraft screen open (s_mutex held).
+static bool CaptureRule(const State& state)
+{
+  return state.bridge->Following() && state.bridge->Playing() && !state.bridge->GalaxyView() &&
+         !state.bridge->ScreenOpen();
+}
+
+bool OnKeyboardMouse(float dx, float dy, float wheel, u32 buttons, const u8 keys[64], bool escape,
+                     float pointer_x, float pointer_y, bool background)
+{
+  std::lock_guard lock(s_mutex);
+  const bool active = s_state && MinecraftHasInput(*s_state);
+  if (!active)
+    return false;
+  s_xinput_updates++;
+  // In SMG2's menus and its own camera (Galaxy view) the mouse is the Wii Remote pointer, and in
+  // a Minecraft screen (the inventory) Minecraft's own pointer: Minecraft does not turn with it.
+  const bool capture = CaptureRule(*s_state);
+  if (capture && (dx != 0 || dy != 0))
+    s_state->input->MouseDelta(dx, dy);
+  const bool screen = s_state->bridge->ScreenOpen() || s_state->bridge->InMenu();
+  s_state->input->Pointer(pointer_x, pointer_y,
+                          screen && pointer_x >= 0 && pointer_x <= 1 && pointer_y >= 0 && pointer_y <= 1,
+                          background);
+  if (wheel != 0)
+    s_state->input->Wheel(wheel);  // notches, up positive (as Minecraft's scroll)
+  // Escape is Minecraft's while one of its screens is open (it closes it) and while Mario is
+  // playable (it opens Minecraft's pause menu, from which SMG2's own is one button away); in
+  // SMG2's menus it is Mario's + button.
+  const bool mc_escape = s_state->bridge->MinecraftTakesEscape();
+  u8 mc_keys[64];
+  std::memcpy(mc_keys, keys, sizeof(mc_keys));
+  if (escape && mc_escape)
+    mc_keys[gxc::SC_ESCAPE / 8] |= 1u << (gxc::SC_ESCAPE % 8);
+  // F11 is Dolphin's fullscreen (its window shows the game); Minecraft's own window is hidden.
+  constexpr int SC_F11 = 68;
+  const bool f11 = (mc_keys[SC_F11 / 8] >> (SC_F11 % 8)) & 1;
+  if (f11 && !s_f11_held)
+    s_fullscreen_requested = true;
+  s_f11_held = f11;
+  mc_keys[SC_F11 / 8] &= ~(1u << (SC_F11 % 8));
+  s_state->input->SetKeys(mc_keys);
+  if (buttons != s_xinput_buttons)
+  {
+    s_xinput_buttons = buttons;
+    s_state->input->Buttons(buttons);
+  }
+  // Mario mode reads Escape (the + button) when Minecraft does not.
+  std::memcpy(s_state->keys, keys, sizeof(s_state->keys));
+  if (escape && !mc_escape)
+    s_state->keys[gxc::SC_ESCAPE / 8] |= 1u << (gxc::SC_ESCAPE % 8);
+  s_state->buttons = buttons;
+  return capture;
+}
+
+bool OnXInput2(float dx, float dy, float dz, u32 x_buttons, const char keymap[32], float pointer_x,
+               float pointer_y)
+{
+  u8 keys[64];
+  gxc::X11KeymapToScancodes(keymap, keys);
+  constexpr int X_ESCAPE = 9;  // X keycode (evdev 1 + 8)
+  const bool escape = (keymap[X_ESCAPE / 8] >> (X_ESCAPE % 8)) & 1;
+  return OnKeyboardMouse(dx, dy, -dz / 8.0f, gxc::X11ButtonsToSdl(x_buttons), keys, escape,
+                         pointer_x, pointer_y, false);
+}
+
+bool OnDInput(long dx, long dy, long dz, const u8 buttons[8], const u8 dik[256], float pointer_x,
+              float pointer_y, bool background)
+{
+  u8 keys[64];
+  gxc::DikKeysToScancodes(dik, keys);
+  constexpr int DIK_ESCAPE = 0x01;
+  const bool escape = (dik[DIK_ESCAPE] & 0x80) != 0;
+  // 120 per notch (WHEEL_DELTA), up positive.
+  return OnKeyboardMouse(static_cast<float>(dx), static_cast<float>(dy), dz / 120.0f,
+                         gxc::DInputButtonsToSdl(buttons), keys, escape, pointer_x, pointer_y,
+                         background);
+}
+
+void OnText(u32 keysym)
+{
+  OnCharacter(gxc::KeysymToCodepoint(keysym));
+}
+
+void OnCharacter(u32 codepoint)
+{
+  // Control characters (Backspace, Return, Tab, Escape, Ctrl+letter) are keys, not text.
+  if (codepoint < 0x20 || codepoint == 0x7F)
+    return;
+  std::lock_guard lock(s_mutex);
+  if (s_state && MinecraftHasInput(*s_state))
+    s_state->input->Text(codepoint);
+}
+
+bool TakeFullscreenRequest()
+{
+  return s_fullscreen_requested.exchange(false);
+}
+
+bool MouseCaptured()
+{
+  std::lock_guard lock(s_mutex);
+  return s_state && CaptureRule(*s_state) && ModAlive(*s_state->shm);
+}
+
+bool BlocksStopHotkey()
+{
+  std::lock_guard lock(s_mutex);
+  return s_state && (s_state->bridge->Following() || s_state->bridge->InMenu());
+}
+
+void NoteRenderFocus(bool focus)
+{
+  (focus ? s_focus_gained : s_focus_lost)++;
+}
+
+void ToggleLink()
+{
+  s_link_toggles++;
+  std::lock_guard lock(s_mutex);
+  if (!s_state)
+    return;
+  s_state->bridge->SetMinecraftMode(!s_state->bridge->MinecraftMode());
+  AnnounceLink(*s_state);
+}
+
+bool OverlayCoversGame()
+{
+  std::lock_guard lock(s_mutex);
+  return s_state && s_state->bridge->InMenu();
+}
+
+void WithOverlay(const std::function<void(u32, u32, u32, const u8*)>& fn)
+{
+  std::lock_guard lock(s_mutex);
+  if (!s_state || !MinecraftHasInput(*s_state))
+    return;
+  // Cutscenes are the game's alone: no hand, hotbar or crosshair until they end.
+  if (s_state->bridge->Cutscene())
+    return;
+  if (auto frame = gxc::LatestOverlay(*s_state->shm))
+    fn(frame->width, frame->height, frame->frame_id, frame->rgba);
+}
+}  // namespace GalaxyCraft
