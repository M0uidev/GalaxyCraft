@@ -0,0 +1,187 @@
+// Copyright 2026 GalaxyCraft contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/GalaxyCraft.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+
+#include "Common/HookableEvent.h"
+#include "Common/Logging/Log.h"
+#include "Core/HW/Memmap.h"
+#include "Core/System.h"
+#include "VideoCommon/VideoEvents.h"
+
+#include "HostBridge.h"
+#include "Input.h"
+#include "Overlay.h"
+#include "Shm.h"
+#include "galaxycraft_protocol.h"
+
+namespace GalaxyCraft
+{
+namespace
+{
+// Emulated RAM through raw pointers with our own bounds checks: the game hands us addresses
+// (e.g. KCL data), and a bad one must be ignored rather than raise Dolphin's panic alerts.
+class DolphinGuestMemory final : public gxc::GuestMemory
+{
+public:
+  explicit DolphinGuestMemory(Memory::MemoryManager& mm) : m_mm(mm) {}
+
+  bool Read(u32 addr, void* dst, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(dst, p, n);
+    return true;
+  }
+
+  bool Write(u32 addr, const void* src, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(p, src, n);
+    return true;
+  }
+
+  std::vector<std::pair<u32, u32>> Regions() override
+  {
+    std::vector<std::pair<u32, u32>> out{{0x80000000u, m_mm.GetRamSizeReal()}};
+    if (m_mm.GetEXRAM())
+      out.emplace_back(0x90000000u, m_mm.GetExRamSizeReal());
+    return out;
+  }
+
+private:
+  u8* Ptr(u32 addr, u32 n)
+  {
+    const u32 base = addr & 0xF0000000u;
+    const u32 off = addr & 0x0FFFFFFFu;
+    if ((base == 0x80000000u || base == 0xC0000000u) &&
+        static_cast<u64>(off) + n <= m_mm.GetRamSizeReal())
+      return m_mm.GetRAM() + off;
+    if ((base == 0x90000000u || base == 0xD0000000u) && m_mm.GetEXRAM() &&
+        static_cast<u64>(off) + n <= m_mm.GetExRamSizeReal())
+      return m_mm.GetEXRAM() + off;
+    return nullptr;
+  }
+
+  Memory::MemoryManager& m_mm;
+};
+
+u64 NowMs()
+{
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+}
+
+struct State
+{
+  std::unique_ptr<gxc::Shm> shm;
+  std::unique_ptr<gxc::HostBridge> bridge;
+  std::unique_ptr<gxc::InputWriter> input;
+  std::unique_ptr<DolphinGuestMemory> memory;
+  Common::EventHook field_hook;
+};
+
+std::mutex s_mutex;
+std::unique_ptr<State> s_state;
+
+bool ModAlive(const gxc::Shm& shm)
+{
+  const u64 hb = shm.GetU64(offsetof(GxcHeader, mod_heartbeat_ms));
+  return hb != 0 && NowMs() - hb < GXC_HEARTBEAT_TIMEOUT_MS;
+}
+}  // namespace
+
+void Start(Core::System& system)
+{
+  const char* env = std::getenv("GALAXYCRAFT");
+  if (!env || std::strcmp(env, "1") != 0)
+    return;
+
+  auto state = std::make_unique<State>();
+  state->shm = gxc::Shm::Create("/dev/shm" GXC_SHM_NAME);
+  if (!state->shm)
+  {
+    ERROR_LOG_FMT(CORE, "GalaxyCraft: could not create /dev/shm{}", GXC_SHM_NAME);
+    return;
+  }
+  state->bridge = std::make_unique<gxc::HostBridge>(*state->shm, NowMs);
+  state->input = std::make_unique<gxc::InputWriter>(*state->shm);
+  state->memory = std::make_unique<DolphinGuestMemory>(system.GetMemory());
+  // Runs on the CPU thread at the end of every video field: emulated RAM is safe to touch.
+  state->field_hook = system.GetVideoEvents().vi_end_field_event.Register([] {
+    std::lock_guard lock(s_mutex);
+    if (s_state)
+      s_state->bridge->Tick(*s_state->memory);
+  });
+
+  std::lock_guard lock(s_mutex);
+  s_state = std::move(state);
+  NOTICE_LOG_FMT(CORE, "GalaxyCraft: bridge running on /dev/shm{}", GXC_SHM_NAME);
+  std::fprintf(stderr, "GalaxyCraft: bridge running on /dev/shm%s\n", GXC_SHM_NAME);
+}
+
+void Stop()
+{
+  std::unique_ptr<State> state;
+  {
+    std::lock_guard lock(s_mutex);
+    state = std::move(s_state);
+  }
+  // Destroying the hook here (outside the lock) waits for nothing: the hook takes s_mutex and
+  // sees s_state == nullptr if it runs concurrently.
+}
+
+bool InputActive()
+{
+  std::lock_guard lock(s_mutex);
+  return s_state && ModAlive(*s_state->shm);
+}
+
+void OnKey(int qt_key, bool down)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->Key(gxc::QtKeyToScancode(qt_key), down);
+}
+
+void OnMouseDelta(double dx, double dy)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->MouseDelta(dx, dy);
+}
+
+void OnMouseButtons(u32 mask)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->Buttons(gxc::QtButtonsToSdl(mask));
+}
+
+void OnWheel(double delta)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->Wheel(delta);
+}
+
+void WithOverlay(const std::function<void(u32, u32, u32, const u8*)>& fn)
+{
+  std::lock_guard lock(s_mutex);
+  if (!s_state || !ModAlive(*s_state->shm))
+    return;
+  if (auto frame = gxc::LatestOverlay(*s_state->shm))
+    fn(frame->width, frame->height, frame->frame_id, frame->rgba);
+}
+}  // namespace GalaxyCraft
