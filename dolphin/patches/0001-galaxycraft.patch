+// Copyright 2026 GalaxyCraft contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <functional>
+
+#include "Common/CommonTypes.h"
+
+namespace Core
+{
+class System;
+}
+
+// GalaxyCraft: bridge between the emulated game and a Minecraft mod over shared memory.
+// Everything is a no-op unless the GALAXYCRAFT environment variable is set to 1.
+namespace GalaxyCraft
+{
+// EmuThread, after HW init / before HW shutdown.
+void Start(Core::System& system);
+void Stop();
+
+// True while Minecraft is connected and the link is on, so keyboard and mouse belong to it.
+bool InputActive();
+
+// XInput2 backend, after every input update (any thread): raw mouse motion since the previous
+// update, X button bits, wheel motion (8 per notch, down positive), the X keymap and where the
+// pointer is over the render window (0..1). Feeds them to Minecraft and Mario mode's Wii Remote,
+// and returns true while the pointer is to be captured and recentred (playing, not in SMG2's
+// menus, where the mouse is the Wii Remote pointer, nor in a Minecraft screen, where it is
+// Minecraft's pointer).
+bool OnXInput2(float dx, float dy, float dz, u32 x_buttons, const char keymap[32], float pointer_x,
+               float pointer_y);
+
+// XInput2 backend: a key typed this X11 keysym (layout applied); Minecraft gets its character.
+void OnText(u32 keysym);
+// Same as OnXInput2's result: the mouse turns Minecraft's view (cursor hidden).
+bool MouseCaptured();
+
+// Savestates roll the game's RAM back but not Minecraft, so they are off: only the dev control
+// channel (save/load, for the test scripts) may use them, on the thread it runs them from.
+bool SavestatesAllowed();
+
+// CPU thread, after a savestate is loaded: the bridge has the mod send the game everything again.
+void OnStateLoaded();
+
+// Mario mode: Escape is the + button, so it must not stop emulation.
+bool BlocksStopHotkey();
+
+// Diagnostics for ctl status: Host::SetRenderFocus reports every focus change here.
+void NoteRenderFocus(bool focus);
+
+// Hotkey "GalaxyCraft: Toggle Minecraft Link" (Ctrl+G by default, under Hotkey Settings > Wii):
+// hand the game to Minecraft or take it back (to use SMG2's menus with the Wii Remote).
+void ToggleLink();
+
+
+// Video thread: Minecraft's menus cover the game (GALAXYCRAFT_BOOT=space, not in a world): until
+// its first frame, the window is a plain GalaxyCraft screen instead of SMG2 booting.
+bool OverlayCoversGame();
+
+// Video thread: calls fn(width, height, frame_id, rgba) with the newest overlay frame, if any
+// (none during cutscenes).
+void WithOverlay(const std::function<void(u32, u32, u32, const u8*)>& fn);
+}  // namespace GalaxyCraft
