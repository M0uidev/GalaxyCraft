@@ -0,0 +1,297 @@
+// Copyright 2026 GalaxyCraft contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/GalaxyCraft.h"
+
+#include <atomic>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+
+#include "Common/HookableEvent.h"
+#include "Common/Logging/Log.h"
+#include "Core/Core.h"
+#include "Core/Host.h"
+#include "Core/HW/Memmap.h"
+#include "Core/State.h"
+#include "Core/System.h"
+#include "VideoCommon/OnScreenDisplay.h"
+#include "VideoCommon/VideoEvents.h"
+
+#include "DevControl.h"
+#include "HostBridge.h"
+#include "Input.h"
+#include "Overlay.h"
+#include "Shm.h"
+#include "galaxycraft_protocol.h"
+
+namespace GalaxyCraft
+{
+namespace
+{
+// Emulated RAM through raw pointers with our own bounds checks: the game hands us addresses
+// (e.g. KCL data), and a bad one must be ignored rather than raise Dolphin's panic alerts.
+class DolphinGuestMemory final : public gxc::GuestMemory
+{
+public:
+  explicit DolphinGuestMemory(Memory::MemoryManager& mm) : m_mm(mm) {}
+
+  bool Read(u32 addr, void* dst, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(dst, p, n);
+    return true;
+  }
+
+  bool Write(u32 addr, const void* src, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(p, src, n);
+    return true;
+  }
+
+  std::vector<std::pair<u32, u32>> Regions() override
+  {
+    std::vector<std::pair<u32, u32>> out{{0x80000000u, m_mm.GetRamSizeReal()}};
+    if (m_mm.GetEXRAM())
+      out.emplace_back(0x90000000u, m_mm.GetExRamSizeReal());
+    return out;
+  }
+
+private:
+  u8* Ptr(u32 addr, u32 n)
+  {
+    const u32 base = addr & 0xF0000000u;
+    const u32 off = addr & 0x0FFFFFFFu;
+    if ((base == 0x80000000u || base == 0xC0000000u) &&
+        static_cast<u64>(off) + n <= m_mm.GetRamSizeReal())
+      return m_mm.GetRAM() + off;
+    if ((base == 0x90000000u || base == 0xD0000000u) && m_mm.GetEXRAM() &&
+        static_cast<u64>(off) + n <= m_mm.GetExRamSizeReal())
+      return m_mm.GetEXRAM() + off;
+    return nullptr;
+  }
+
+  Memory::MemoryManager& m_mm;
+};
+
+// Diagnostics (ctl status); atomics because focus changes arrive on the Qt thread.
+std::atomic<int> s_focus_gained{0};
+std::atomic<int> s_focus_lost{0};
+std::atomic<int> s_link_toggles{0};
+
+// Development control channel (tools/gxdev.py): commands in, results appended out.
+constexpr const char* CTL_PATH = "/dev/shm/galaxycraft_ctl";
+constexpr const char* CTL_OUT_PATH = "/dev/shm/galaxycraft_ctl.out";
+
+void AppendCtlOut(const std::string& text)
+{
+  std::ofstream(CTL_OUT_PATH, std::ios::app) << text;
+}
+
+// CPU thread. Memory commands run right away; screenshots and savestates go to the host thread,
+// which is where Dolphin expects them to be started.
+void RunControlFile(gxc::GuestMemory& mem, gxc::HostBridge& bridge, bool mod_alive)
+{
+  std::error_code ec;
+  if (!std::filesystem::exists(CTL_PATH, ec))
+    return;
+  std::stringstream text;
+  text << std::ifstream(CTL_PATH).rdbuf();
+  std::filesystem::remove(CTL_PATH, ec);
+
+  for (const gxc::DevCommand& cmd : gxc::ParseDevCommands(text.str()))
+  {
+    switch (cmd.kind)
+    {
+    case gxc::DevCommand::Shot:
+      Core::QueueHostJob([name = cmd.arg](Core::System&) {
+        Core::SaveScreenShot(name);
+        AppendCtlOut("ok shot " + name + "\n");
+      });
+      break;
+    case gxc::DevCommand::Save:
+    case gxc::DevCommand::Load:
+      Core::QueueHostJob([cmd](Core::System& system) {
+        if (cmd.kind == gxc::DevCommand::Save)
+          State::SaveAs(system, cmd.arg);
+        else
+          State::LoadAs(system, cmd.arg);
+        AppendCtlOut(std::string(cmd.kind == gxc::DevCommand::Save ? "ok save " : "ok load ") +
+                     cmd.arg + "\n");
+      });
+      break;
+    case gxc::DevCommand::Drive:
+    {
+      const auto& v = cmd.pose;
+      bridge.SetDevDrive(gxc::PlayerState{0, 0, {v[0], v[1], v[2]}, {v[3], v[4], v[5]},
+                                          {v[6], v[7], v[8]}, 70.f, 162.f});
+      AppendCtlOut("ok drive\n");
+      break;
+    }
+    case gxc::DevCommand::Link:
+      bridge.SetLinkEnabled(cmd.arg == "on");
+      AppendCtlOut("ok link " + cmd.arg + "\n");
+      break;
+    case gxc::DevCommand::Status:
+      // Dolphin only reads controllers and hotkeys while these let it (Core::UpdateInputGate).
+      AppendCtlOut(fmt::format("render_focus={} full_focus={} ui_blocks_input={} link={} mod_alive={} "
+                               "driving={} focus_gained={} focus_lost={} link_toggles={}\n",
+                               Host_RendererHasFocus(), Host_RendererHasFullFocus(),
+                               Host_UIBlocksControllerState(), bridge.LinkEnabled(),
+                               mod_alive, bridge.Driving(), s_focus_gained.load(),
+                               s_focus_lost.load(), s_link_toggles.load()));
+      break;
+    case gxc::DevCommand::Undrive:
+      bridge.SetDevDrive(std::nullopt);
+      AppendCtlOut("ok undrive\n");
+      break;
+    default:
+      AppendCtlOut(gxc::RunMemoryCommand(cmd, mem, bridge.MailboxAddress()));
+      break;
+    }
+  }
+}
+
+u64 NowMs()
+{
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+}
+
+struct State
+{
+  std::unique_ptr<gxc::Shm> shm;
+  std::unique_ptr<gxc::HostBridge> bridge;
+  std::unique_ptr<gxc::InputWriter> input;
+  std::unique_ptr<DolphinGuestMemory> memory;
+  Common::EventHook field_hook;
+};
+
+std::mutex s_mutex;
+std::unique_ptr<State> s_state;
+
+bool ModAlive(const gxc::Shm& shm)
+{
+  const u64 hb = shm.GetU64(offsetof(GxcHeader, mod_heartbeat_ms));
+  return hb != 0 && NowMs() - hb < GXC_HEARTBEAT_TIMEOUT_MS;
+}
+}  // namespace
+
+void Start(Core::System& system)
+{
+  const char* env = std::getenv("GALAXYCRAFT");
+  if (!env || std::strcmp(env, "1") != 0)
+    return;
+
+  auto state = std::make_unique<State>();
+  state->shm = gxc::Shm::Create("/dev/shm" GXC_SHM_NAME);
+  if (!state->shm)
+  {
+    ERROR_LOG_FMT(CORE, "GalaxyCraft: could not create /dev/shm{}", GXC_SHM_NAME);
+    return;
+  }
+  state->bridge = std::make_unique<gxc::HostBridge>(*state->shm, NowMs);
+  state->input = std::make_unique<gxc::InputWriter>(*state->shm);
+  state->memory = std::make_unique<DolphinGuestMemory>(system.GetMemory());
+  // Runs on the CPU thread at the end of every video field: emulated RAM is safe to touch.
+  state->field_hook = system.GetVideoEvents().vi_end_field_event.Register([] {
+    std::lock_guard lock(s_mutex);
+    if (!s_state)
+      return;
+    s_state->bridge->Tick(*s_state->memory);
+    RunControlFile(*s_state->memory, *s_state->bridge, ModAlive(*s_state->shm));
+  });
+
+  std::lock_guard lock(s_mutex);
+  s_state = std::move(state);
+  NOTICE_LOG_FMT(CORE, "GalaxyCraft: bridge running on /dev/shm{}", GXC_SHM_NAME);
+  std::fprintf(stderr, "GalaxyCraft: bridge running on /dev/shm%s\n", GXC_SHM_NAME);
+}
+
+void Stop()
+{
+  std::unique_ptr<State> state;
+  {
+    std::lock_guard lock(s_mutex);
+    state = std::move(s_state);
+  }
+  // Destroying the hook here (outside the lock) waits for nothing: the hook takes s_mutex and
+  // sees s_state == nullptr if it runs concurrently.
+}
+
+bool InputActive()
+{
+  std::lock_guard lock(s_mutex);
+  return s_state && s_state->bridge->LinkEnabled() && ModAlive(*s_state->shm);
+}
+
+void NoteRenderFocus(bool focus)
+{
+  (focus ? s_focus_gained : s_focus_lost)++;
+}
+
+void ToggleLink()
+{
+  s_link_toggles++;
+  std::lock_guard lock(s_mutex);
+  if (!s_state)
+    return;
+  const bool on = !s_state->bridge->LinkEnabled();
+  s_state->bridge->SetLinkEnabled(on);
+  if (!on)
+    s_state->input->ReleaseAll();  // keys held now would otherwise stay down in Minecraft
+  NOTICE_LOG_FMT(CORE, "GalaxyCraft: link {}", on ? "on" : "off");
+  OSD::AddMessage(on ? "GalaxyCraft: Minecraft has the controls" :
+                       "GalaxyCraft: Wii Remote has the controls (Minecraft paused)",
+                  3000);
+}
+
+void OnKey(int qt_key, bool down)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->Key(gxc::QtKeyToScancode(qt_key), down);
+}
+
+void OnMouseDelta(double dx, double dy)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->MouseDelta(dx, dy);
+}
+
+void OnMouseButtons(u32 mask)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->Buttons(gxc::QtButtonsToSdl(mask));
+}
+
+void OnWheel(double delta)
+{
+  std::lock_guard lock(s_mutex);
+  if (s_state)
+    s_state->input->Wheel(delta);
+}
+
+void WithOverlay(const std::function<void(u32, u32, u32, const u8*)>& fn)
+{
+  std::lock_guard lock(s_mutex);
+  if (!s_state || !s_state->bridge->LinkEnabled() || !ModAlive(*s_state->shm))
+    return;
+  if (auto frame = gxc::LatestOverlay(*s_state->shm))
+    fn(frame->width, frame->height, frame->frame_id, frame->rgba);
+}
+}  // namespace GalaxyCraft
