+// While Minecraft is connected (GalaxyCraft), keyboard and mouse go to it: keys as SDL scancodes and
+// the mouse as relative motion, re-centering the hidden cursor. Escape still reaches Dolphin.
+bool RenderWidget::PassEventToGalaxyCraft(QEvent* event)
+{
+  // Under some XWayland compositors (Hyprland) a click focuses this window without Qt ever
+  // hearing about it, so Dolphin never feels focused and ignores controllers and hotkeys.
+  // Asking for activation on click brings Qt (and Host::SetRenderFocus) back in line.
+  if (event->type() == QEvent::MouseButtonPress && !isActiveWindow())
+    activateWindow();
+
+  const bool active = GalaxyCraft::InputActive();
+  if (active != m_galaxycraft_input)
+  {
+    m_galaxycraft_input = active;
+    setCursor(active ? Qt::BlankCursor : Qt::ArrowCursor);
+  }
+  if (!active)
+    return false;
+
+  switch (event->type())
+  {
+  case QEvent::KeyPress:
+  case QEvent::KeyRelease:
+  {
+    const auto* key_event = static_cast<const QKeyEvent*>(event);
+    if (key_event->key() == Qt::Key_Escape)
+      return false;
+    if (!key_event->isAutoRepeat())
+      GalaxyCraft::OnKey(key_event->key(), event->type() == QEvent::KeyPress);
+    return true;
+  }
+  case QEvent::MouseMove:
+  {
+    const QPoint center(width() / 2, height() / 2);
+    const QPoint delta = static_cast<const QMouseEvent*>(event)->pos() - center;
+    if (!delta.isNull())
+    {
+      const float scale = devicePixelRatio();
+      GalaxyCraft::OnMouseDelta(delta.x() * scale, delta.y() * scale);
+      QCursor::setPos(mapToGlobal(center));  // the resulting move event has a zero delta
+    }
+    return true;
+  }
+  case QEvent::MouseButtonPress:
+  case QEvent::MouseButtonRelease:
+    setFocus();
+    GalaxyCraft::OnMouseButtons(static_cast<u32>(static_cast<const QMouseEvent*>(event)->buttons()));
+    return true;
+  case QEvent::Wheel:
+    GalaxyCraft::OnWheel(static_cast<const QWheelEvent*>(event)->angleDelta().y() / 120.0);
+    return true;
+  default:
+    return false;
+  }
+}
