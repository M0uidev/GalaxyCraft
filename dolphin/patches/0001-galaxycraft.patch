+void Log(const std::string& line)
+{
+  std::fprintf(stderr, "GalaxyCraft: %s\n", line.c_str());
+  std::lock_guard lock(s_log_mutex);
+  if (s_log_path.empty())
+    return;
+  const auto now = std::chrono::floor<std::chrono::seconds>(std::chrono::system_clock::now());
+  File::IOFile(s_log_path, "ab").WriteString(fmt::format("{:%Y-%m-%d %H:%M:%S} UTC {}\n", now, line));
+}
