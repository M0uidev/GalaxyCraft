+// Copyright 2026 GalaxyCraft contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <functional>
+
+#include "Common/CommonTypes.h"
+
+namespace Core
+{
+class System;
+}
+
+// GalaxyCraft: bridge between the emulated game and a Minecraft mod over shared memory.
+// Everything is a no-op unless the GALAXYCRAFT environment variable is set to 1.
+namespace GalaxyCraft
+{
+// EmuThread, after HW init / before HW shutdown.
+void Start(Core::System& system);
+void Stop();
+
+// True while Minecraft is connected and the link is on, so keyboard and mouse belong to it.
+bool InputActive();
+
+// Diagnostics for ctl status: Host::SetRenderFocus reports every focus change here.
+void NoteRenderFocus(bool focus);
+
+// Hotkey "GalaxyCraft: Toggle Minecraft Link" (Ctrl+G by default, under Hotkey Settings > Wii):
+// hand the game to Minecraft or take it back (to use SMG2's menus with the Wii Remote).
+void ToggleLink();
+
+// Qt thread.
+void OnKey(int qt_key, bool down);
+void OnMouseDelta(double dx, double dy);
+void OnMouseButtons(u32 qt_buttons);
+void OnWheel(double delta);
+
+// Video thread: calls fn(width, height, frame_id, rgba) with the newest overlay frame, if any.
+void WithOverlay(const std::function<void(u32, u32, u32, const u8*)>& fn);
+}  // namespace GalaxyCraft
