+void OnScreenUI::DrawGalaxyCraftOverlay()
+{
+  bool visible = false;
+  GalaxyCraft::WithOverlay([&](u32 width, u32 height, u32 frame_id, const u8* rgba) {
+    if (!m_galaxycraft_texture || m_galaxycraft_texture->GetWidth() != width ||
+        m_galaxycraft_texture->GetHeight() != height)
+    {
+      TextureConfig config(width, height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                           AbstractTextureType::Texture_2DArray);
+      m_galaxycraft_texture = g_gfx->CreateTexture(config, "GalaxyCraft overlay");
+      m_galaxycraft_frame_id = UINT32_MAX;
+    }
+    if (!m_galaxycraft_texture)
+      return;
+    if (frame_id != m_galaxycraft_frame_id)
+    {
+      m_galaxycraft_texture->Load(0, width, height, width, rgba, sizeof(u32) * width * height);
+      m_galaxycraft_frame_id = frame_id;
+    }
+    visible = true;
+  });
+  if (visible)
+  {
+    static bool s_logged = false;
+    if (!s_logged)
+    {
+      s_logged = true;
+      GalaxyCraft::Log(fmt::format("compositing Minecraft overlay {}x{}",
+                                   m_galaxycraft_texture->GetWidth(),
+                                   m_galaxycraft_texture->GetHeight()));
+    }
+    ImGui::GetBackgroundDrawList()->AddImage(*m_galaxycraft_texture, ImVec2(0, 0),
+                                             ImGui::GetIO().DisplaySize);
+  }
+  else if (GalaxyCraft::OverlayCoversGame())
+  {
+    // Minecraft's menus will cover the game; until its first frame, SMG2 booting stays hidden.
+    const ImVec2 size = ImGui::GetIO().DisplaySize;
+    ImDrawList* list = ImGui::GetBackgroundDrawList();
+    list->AddRectFilled(ImVec2(0, 0), size, IM_COL32(12, 10, 24, 255));
+    const char* title = "Super Minecraft Galaxy";
+    const ImVec2 text = ImGui::CalcTextSize(title);
+    list->AddText(ImVec2((size.x - text.x) / 2, (size.y - text.y) / 2), IM_COL32(230, 230, 240, 255), title);
+  }
+}
