+// Copyright 2026 GalaxyCraft contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <functional>
+#include <string>
+
+#include "Common/CommonTypes.h"
+
+namespace Core
+{
+class System;
+}
+
+// GalaxyCraft: bridge between the emulated game and a Minecraft mod over shared memory.
+// Everything is a no-op unless the GALAXYCRAFT environment variable is set to 1.
+namespace GalaxyCraft
+{
+// EmuThread, after HW init / before HW shutdown.
+void Start(Core::System& system);
+void Stop();
+
+// True while Minecraft is connected and the link is on, so keyboard and mouse belong to it.
+bool InputActive();
+
+// The keyboard and mouse backend (XInput2 on Linux, DirectInput on Windows), after every input
+// update (any thread): raw mouse motion since the previous update, wheel notches since then (up
+// positive), the mouse buttons (bit n = SDL button n), the keys held as SDL scancodes (Escape left
+// out), whether Escape is held, where the pointer is over the render window (0..1), and whether
+// that window is in the background (another one in front: Minecraft pauses). Feeds them to
+// Minecraft and Mario mode's Wii Remote, and returns true while the pointer is to be captured
+// and recentred (playing, not in SMG2's menus, where the mouse is the Wii Remote pointer, nor in a
+// Minecraft screen, where it is Minecraft's pointer).
+bool OnKeyboardMouse(float dx, float dy, float wheel, u32 buttons, const u8 keys[64], bool escape,
+                     float pointer_x, float pointer_y, bool background);
+
+// XInput2 backend, after every input update: OnKeyboardMouse with X11's raw motion, X button bits,
+// wheel motion (8 per notch, down positive) and X keymap (XQueryKeymap).
+bool OnXInput2(float dx, float dy, float dz, u32 x_buttons, const char keymap[32], float pointer_x,
+               float pointer_y);
+
+// DirectInput backend, after every input update: OnKeyboardMouse with DIMOUSESTATE2's relative
+// motion (lX, lY, lZ: 120 per wheel notch, up positive) and buttons, and the DIK_* key states.
+bool OnDInput(long dx, long dy, long dz, const u8 buttons[8], const u8 dik[256], float pointer_x,
+              float pointer_y, bool background);
+
+// XInput2 backend: a key typed this X11 keysym (layout applied); Minecraft gets its character.
+void OnText(u32 keysym);
+// A character typed (Unicode code point, layout applied: Qt's key text on Windows); Minecraft
+// gets it. Control characters are ignored.
+void OnCharacter(u32 codepoint);
+
+// Dolphin's GalaxyCraft log: stderr and <User>/Logs/galaxycraft.log (new each run).
+void Log(const std::string& line);
+// Same as OnKeyboardMouse's result: the mouse turns Minecraft's view (cursor hidden).
+bool MouseCaptured();
+
+// F11 was pressed while Minecraft has the keyboard (it never gets F11): true once, and the hotkey
+// thread toggles Dolphin's fullscreen.
+bool TakeFullscreenRequest();
+
+// Savestates roll the game's RAM back but not Minecraft, so they are off: only the dev control
+// channel (save/load, for the test scripts) may use them, on the thread it runs them from.
+bool SavestatesAllowed();
+
+// CPU thread, a read or write of unmapped memory (no MMU emulation): with the bridge running it
+// is logged (address, PC, LR, how often) instead of a dialog each time, and true is returned.
+bool OnInvalidAccess(u32 address, u32 pc, u32 lr, bool write);
+
+// CPU thread, after a savestate is loaded: the bridge has the mod send the game everything again.
+void OnStateLoaded();
+
+// Mario mode: Escape is the + button, so it must not stop emulation.
+bool BlocksStopHotkey();
+
+// Diagnostics for ctl status: Host::SetRenderFocus reports every focus change here.
+void NoteRenderFocus(bool focus);
+
+// Hotkey "Super Minecraft Galaxy: Toggle Minecraft Link" (Ctrl+G by default, under Hotkey Settings > Wii):
+// hand the game to Minecraft or take it back (to use SMG2's menus with the Wii Remote).
+void ToggleLink();
+
+
+// Video thread: Minecraft's menus cover the game (GALAXYCRAFT_BOOT=space, not in a world): until
+// its first frame, the window is a plain GalaxyCraft screen instead of SMG2 booting.
+bool OverlayCoversGame();
+
+// Video thread: calls fn(width, height, frame_id, rgba) with the newest overlay frame, if any
+// (none during cutscenes).
+void WithOverlay(const std::function<void(u32, u32, u32, const u8*)>& fn);
+}  // namespace GalaxyCraft
