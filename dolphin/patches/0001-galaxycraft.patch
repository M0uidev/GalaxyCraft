+// While Minecraft is connected (GalaxyCraft), keyboard and mouse go to it: keys as SDL scancodes and
+// the mouse as relative motion, re-centering the hidden cursor. Escape still reaches Dolphin.
+bool RenderWidget::PassEventToGalaxyCraft(QEvent* event)
+{
+  // Under some XWayland compositors (Hyprland) a click focuses this window without Qt ever
+  // hearing about it, so Dolphin never feels focused and ignores controllers and hotkeys.
+  // Asking for activation on click brings Qt (and Host::SetRenderFocus) back in line.
+  if (event->type() == QEvent::MouseButtonPress && !isActiveWindow())
+    activateWindow();
+
+  // While Minecraft owns keyboard and mouse, the XInput2 backend feeds it (GalaxyCraft::OnXInput2)
+  // and keeps the pointer centred; here the events only need to stay away from Dolphin's UI.
+  if (!GalaxyCraft::InputActive())
+    return false;
+
+  switch (event->type())
+  {
+  case QEvent::KeyPress:
+#ifdef _WIN32
+    // Windows: what the keys type (layout, dead keys and AltGr applied) comes from Qt; on X11 the
+    // XInput2 backend reads it (GalaxyCraft::OnText), as Qt may never have the focus there.
+    for (const uint c : static_cast<const QKeyEvent*>(event)->text().toUcs4())
+      GalaxyCraft::OnCharacter(c);
+#endif
+    [[fallthrough]];
+  case QEvent::KeyRelease:
+    return static_cast<const QKeyEvent*>(event)->key() != Qt::Key_Escape;
+  case QEvent::MouseMove:
+  case QEvent::MouseButtonPress:
+  case QEvent::MouseButtonRelease:
+  case QEvent::Wheel:
+    return true;
+  default:
+    return false;
+  }
+}
+
+// While Minecraft has keyboard and mouse the cursor is ours: hidden while the mouse turns its view,
+// shown in SMG2's menus (the Wii Remote pointer) and Minecraft's screens (its pointer). Dolphin's
+// hide-on-idle would leave it hidden there, as the mouse moves never reach it.
+void RenderWidget::UpdateGalaxyCraftCursor()
+{
+  const bool active = GalaxyCraft::InputActive();
+  if (!active)
+  {
+    if (m_galaxycraft_input)
+    {
+      m_galaxycraft_input = false;
+      UpdateCursor();
+    }
+    return;
+  }
+  m_galaxycraft_input = true;
+  const Qt::CursorShape shape = GalaxyCraft::MouseCaptured() ? Qt::BlankCursor : Qt::ArrowCursor;
+  if (cursor().shape() != shape)
+    setCursor(shape);
+}
