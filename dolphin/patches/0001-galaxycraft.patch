+// GalaxyCraft: Minecraft reads keyboard and mouse from here (as from XInput2 on Linux), only while
+// Dolphin's window is the one in front: with background input on, keys and mouse would otherwise
+// reach the game while the player types elsewhere, and the cursor would stay caught.
+void KeyboardMouse::UpdateGalaxyCraft(const DIMOUSESTATE2& mouse)
+{
+  const HWND hwnd = s_hwnd;
+  const bool foreground = hwnd && GetForegroundWindow() == GetAncestor(hwnd, GA_ROOT);
+  float pointer_x = -1, pointer_y = -1;
+  RECT rect{};
+  POINT point{};
+  if (foreground && GetClientRect(hwnd, &rect) && GetCursorPos(&point) &&
+      ScreenToClient(hwnd, &point) && rect.right > 0 && rect.bottom > 0)
+  {
+    pointer_x = static_cast<float>(point.x) / rect.right;
+    pointer_y = static_cast<float>(point.y) / rect.bottom;
+  }
+  static constexpr BYTE NO_KEYS[256] = {};
+  static constexpr BYTE NO_BUTTONS[8] = {};
+  bool capture = false;
+  if (foreground)
+  {
+    capture = GalaxyCraft::OnDInput(mouse.lX, mouse.lY, mouse.lZ, mouse.rgbButtons,
+                                    m_state_in.keyboard, pointer_x, pointer_y, false);
+  }
+  else
+  {
+    GalaxyCraft::OnDInput(0, 0, 0, NO_BUTTONS, NO_KEYS, -1, -1, true);  // everything let go
+  }
+  CaptureForGalaxyCraft(capture);
+}
+
+// While captured the cursor is kept inside the render window and recentred on every update, so
+// the mouse keeps moving at the screen's edges; RenderWidget hides it (Qt::BlankCursor).
+void KeyboardMouse::CaptureForGalaxyCraft(bool capture)
+{
+  if (!capture)
+  {
+    if (m_galaxycraft_capture)
+      ClipCursor(nullptr);
+    m_galaxycraft_capture = false;
+    return;
+  }
+  m_galaxycraft_capture = true;
+  RECT rect{};
+  if (!GetClientRect(s_hwnd, &rect))
+    return;
+  POINT top_left{rect.left, rect.top};
+  POINT bottom_right{rect.right, rect.bottom};
+  ClientToScreen(s_hwnd, &top_left);
+  ClientToScreen(s_hwnd, &bottom_right);
+  const RECT clip{top_left.x, top_left.y, bottom_right.x, bottom_right.y};
+  ClipCursor(&clip);
+  SetCursorPos((top_left.x + bottom_right.x) / 2, (top_left.y + bottom_right.y) / 2);
+}
