+// Emulated RAM through raw pointers with our own bounds checks: the game hands us addresses
+// (e.g. KCL data), and a bad one must be ignored rather than raise Dolphin's panic alerts.
+class DolphinGuestMemory final : public gxc::GuestMemory
+{
+public:
+  explicit DolphinGuestMemory(Memory::MemoryManager& mm) : m_mm(mm) {}
+
+  bool Read(u32 addr, void* dst, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(dst, p, n);
+    return true;
+  }
+
+  bool Write(u32 addr, const void* src, u32 n) override
+  {
+    u8* p = Ptr(addr, n);
+    if (!p)
+      return false;
+    std::memcpy(p, src, n);
+    return true;
+  }
+
+  std::vector<std::pair<u32, u32>> Regions() override
+  {
+    std::vector<std::pair<u32, u32>> out{{0x80000000u, m_mm.GetRamSizeReal()}};
+    if (m_mm.GetEXRAM())
+      out.emplace_back(0x90000000u, m_mm.GetExRamSizeReal());
+    return out;
+  }
+
+private:
+  u8* Ptr(u32 addr, u32 n)
+  {
+    const u32 base = addr & 0xF0000000u;
+    const u32 off = addr & 0x0FFFFFFFu;
+    if ((base == 0x80000000u || base == 0xC0000000u) &&
+        static_cast<u64>(off) + n <= m_mm.GetRamSizeReal())
+      return m_mm.GetRAM() + off;
+    if ((base == 0x90000000u || base == 0xD0000000u) && m_mm.GetEXRAM() &&
+        static_cast<u64>(off) + n <= m_mm.GetExRamSizeReal())
+      return m_mm.GetEXRAM() + off;
+    return nullptr;
+  }
+
+  Memory::MemoryManager& m_mm;
+};
+
+// Diagnostics (ctl status); atomics because focus changes arrive on the Qt thread.
+std::atomic<int> s_focus_gained{0};
+std::atomic<int> s_focus_lost{0};
+std::atomic<int> s_link_toggles{0};
+std::atomic<int> s_xinput_updates{0};
+thread_local bool t_dev_savestate = false;  // a ctl save/load is calling into State
+u32 s_xinput_buttons = 0;  // under s_mutex
+
+// The Wii Remote state Mario mode reports, read by the input override (CPU thread, under the
+// controllers' state lock) and written once per field. Its own mutex: the override must never
+// wait on s_mutex, which the field hook holds while it takes the state lock.
+std::mutex s_pad_mutex;
+gxc::WiimoteState s_pad;
+
+std::optional<ControlState> OverrideInput(std::string_view group, std::string_view control,
+                                          ControlState)
+{
+  gxc::WiimoteState pad;
+  {
+    std::lock_guard lock(s_pad_mutex);
+    pad = s_pad;
+  }
+  if (group == "Buttons")
+  {
+    const std::pair<std::string_view, bool> buttons[] = {
+        {"A", pad.a},   {"B", pad.b}, {"-", pad.minus}, {"+", pad.plus}, {"Home", pad.home},
+        {"1", pad.one}, {"2", pad.two}, {"C", pad.c},   {"Z", pad.z}};
+    for (const auto& [name, down] : buttons)
+      if (control == name)
+        return down ? 1.0 : 0.0;
+  }
+  if (group == "Stick" && (control == "X" || control == "Y"))
+    return control == "X" ? pad.stick_x : pad.stick_y;
+  if (group == "IR" && (control == "X" || control == "Y") && pad.center_ir)
+    return control == "X" ? 0.0 : gxc::MarioInput::CENTER_IR_Y;
+  if (group == "Shake")
+    return pad.shake ? 1.0 : 0.0;
+  return std::nullopt;
+}
+
+// Wii Remote 1 and its Nunchuk (CPU thread, which is where they are read).
+void SetWiimoteOverride(bool on)
+{
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  auto* wiimote = static_cast<WiimoteEmu::Wiimote*>(Wiimote::GetConfig()->GetController(0));
+  auto* attachments = static_cast<ControllerEmu::Attachments*>(
+      wiimote->GetWiimoteGroup(WiimoteEmu::WiimoteGroup::Attachments));
+  auto& nunchuk = attachments->GetAttachmentList()[WiimoteEmu::ExtensionNumber::NUNCHUK];
+  if (on)
+  {
+    wiimote->SetInputOverrideFunction(OverrideInput);
+    nunchuk->SetInputOverrideFunction(OverrideInput);
+  }
+  else
+  {
+    wiimote->ClearInputOverrideFunction();
+    nunchuk->ClearInputOverrideFunction();
+  }
+}
+
+struct State
+{
+  std::unique_ptr<gxc::Shm> shm;
+  std::unique_ptr<gxc::HostBridge> bridge;
+  std::unique_ptr<gxc::InputWriter> input;
+  std::unique_ptr<DolphinGuestMemory> memory;
+  Common::EventHook field_hook;
+  gxc::MarioInput mario;
+  bool override_on = false;
+  bool link_shown = true;  // the bridge's Minecraft mode as last announced
+  bool muted = false;      // the game's sound off while Minecraft's menus show (InMenu)
+  u8 keys[64] = {};  // keyboard and mouse as of the last XInput2 update (Escape included)
+  u32 buttons = 0;
+  std::optional<std::pair<std::array<u8, 64>, u32>> dev_keys;  // ctl keys, while set
+};
+
+// ctl keys: hold these (names as DevKeysToInput) until the next keys; none = back to XInput2.
+void SetDevKeys(State& state, const std::string& names)
+{
+  std::array<u8, 64> keys{};
+  u32 buttons = 0;
+  gxc::DevKeysToInput(names, keys.data(), buttons);
+  if (names.empty())
+    state.dev_keys.reset();
+  else
+    state.dev_keys.emplace(keys, buttons);
+}
+
+// Field hook, after Tick: Mario mode's Wii Remote follows keyboard and mouse while following;
+// in Minecraft's menus it is held neutral (no other controller reaches the game).
+void UpdateMarioInput(State& state)
+{
+  const bool following = state.bridge->Following();
+  const bool override = following || state.bridge->InMenu();
+  if (override != state.override_on)
+  {
+    state.mario.Reset();
+    SetWiimoteOverride(override);
+    state.override_on = override;
+  }
+  gxc::WiimoteState pad;
+  if (following)
+  {
+    // With a Minecraft screen open (the chat) the keyboard and mouse type there, and while the
+    // player flies (/fly) or walks by Minecraft's movement they move it: Mario stays put, or goes
+    // where the player is.
+    static const u8 none[64] = {};
+    const bool screen =
+        state.bridge->ScreenOpen() || state.bridge->Flying() || state.bridge->Walking();
+    const u8* keys = state.dev_keys ? state.dev_keys->first.data() : screen ? none : state.keys;
+    const u32 buttons = state.dev_keys ? state.dev_keys->second : screen ? 0u : state.buttons;
+    pad = state.mario.Update(keys, buttons, state.bridge->InGame(), state.bridge->GalaxyView(),
+                             state.bridge->ItemActive(), state.bridge->McFeel());
+    state.bridge->SetGait(pad.sprint, pad.sneak, pad.walking);
+    // Minecraft's pause menu opens SMG2's own: the mod holds + for a few frames.
+    pad.plus = pad.plus || state.bridge->PlusHeld();
+  }
+  std::lock_guard lock(s_pad_mutex);
+  s_pad = pad;
+}
+
+// Field hook: the game is silent while Minecraft's menus cover it (its own sound plays there).
+void UpdateMute(State& state)
+{
+  const bool mute = state.bridge->InMenu();
+  if (mute == state.muted)
+    return;
+  state.muted = mute;
+  Core::QueueHostJob([mute](Core::System& system) {
+    if (SoundStream* stream = system.GetSoundStream())
+      stream->SetVolume(mute || Config::Get(Config::MAIN_AUDIO_MUTED) ? 0 : Config::Get(Config::MAIN_AUDIO_VOLUME));
+  });
+}
+
+// Development control channel (tools/gxdev.py): commands in, results appended out.
+constexpr const char* CTL_PATH = "/dev/shm/galaxycraft_ctl";
+constexpr const char* CTL_OUT_PATH = "/dev/shm/galaxycraft_ctl.out";
+
+void AppendCtlOut(const std::string& text)
+{
+  std::ofstream(CTL_OUT_PATH, std::ios::app) << text;
+}
+
+// CPU thread. Memory commands run right away; screenshots and savestates go to the host thread,
+// which is where Dolphin expects them to be started.
+void RunControlFile(gxc::GuestMemory& mem, gxc::HostBridge& bridge, bool mod_alive, State& state)
+{
+  std::error_code ec;
+  if (!std::filesystem::exists(CTL_PATH, ec))
+    return;
+  std::stringstream text;
+  text << std::ifstream(CTL_PATH).rdbuf();
+  std::filesystem::remove(CTL_PATH, ec);
+
+  for (const gxc::DevCommand& cmd : gxc::ParseDevCommands(text.str()))
+  {
+    switch (cmd.kind)
+    {
+    case gxc::DevCommand::Shot:
+      Core::QueueHostJob([name = cmd.arg](Core::System&) {
+        Core::SaveScreenShot(name);
+        AppendCtlOut("ok shot " + name + "\n");
+      });
+      break;
+    case gxc::DevCommand::Save:
+    case gxc::DevCommand::Load:
+      Core::QueueHostJob([cmd](Core::System& system) {
+        t_dev_savestate = true;
+        if (cmd.kind == gxc::DevCommand::Save)
+          ::State::SaveAs(system, cmd.arg);
+        else
+          ::State::LoadAs(system, cmd.arg);
+        t_dev_savestate = false;
+        AppendCtlOut(std::string(cmd.kind == gxc::DevCommand::Save ? "ok save " : "ok load ") +
+                     cmd.arg + "\n");
+      });
+      break;
+    case gxc::DevCommand::Follow:
+    {
+      const auto& v = cmd.pose;
+      gxc::PlayerState pose{0, 0, {}, {v[0], v[1], v[2]}, {v[3], v[4], v[5]}, 70.f, 162.f};
+      if (cmd.addr & 2)
+        pose.flags |= GXC_PLAYER_MC_FEEL;
+      if (cmd.addr & 1)  // third person: 4 blocks (320 units) behind the eyes
+      {
+        pose.cam_offset = {-v[0] * 320.f, 130.f - v[1] * 320.f, -v[2] * 320.f};
+        pose.view = GXC_VIEW_BACK;
+      }
+      bridge.SetDevFollow(pose);
+      AppendCtlOut("ok follow\n");
+      break;
+    }
+    case gxc::DevCommand::Link:
+      bridge.SetMinecraftMode(cmd.arg == "on");
+      AppendCtlOut("ok link " + cmd.arg + "\n");
+      break;
+    case gxc::DevCommand::Status:
+    {
+      // Dolphin only reads controllers and hotkeys while these let it (Core::UpdateInputGate).
+      // max_speed: how fast emulation could run unthrottled, percent (what a planet costs).
+      const auto& perf = Core::System::GetInstance().GetPerfMetrics();
+      AppendCtlOut(fmt::format("render_focus={} full_focus={} ui_blocks_input={} link={} mod_alive={} "
+                               "following={} in_game={} focus_gained={} focus_lost={} link_toggles={} "
+                               "xinput_updates={} fps={:.1f} vps={:.1f} speed={:.0f} max_speed={:.0f} mario_skin_writes={} plus_held={}\n",
+                               Host_RendererHasFocus(), Host_RendererHasFullFocus(),
+                               Host_UIBlocksControllerState(), bridge.MinecraftMode(),
+                               mod_alive, bridge.Following(), bridge.InGame(), s_focus_gained.load(),
+                               s_focus_lost.load(), s_link_toggles.load(),
+                               s_xinput_updates.load(), perf.GetFPS(), perf.GetVPS(), perf.GetSpeed() * 100,
+                               perf.GetMaxSpeed() * 100, bridge.MarioSkinWrites(), bridge.PlusHeld()));
+    }
+      break;
+    case gxc::DevCommand::Keys:
+      SetDevKeys(state, cmd.arg);
+      AppendCtlOut("ok keys " + cmd.arg + "\n");
+      break;
+    case gxc::DevCommand::Lean:
+      state.mario.SetLeans(cmd.pose[0], cmd.pose[1], cmd.pose[2]);
+      AppendCtlOut("ok lean\n");
+      break;
+    case gxc::DevCommand::Text:
+      for (const char c : cmd.arg)
+        state.input->Text(static_cast<u8>(c));
+      AppendCtlOut("ok text\n");
+      break;
+    case gxc::DevCommand::Unfollow:
+      bridge.SetDevFollow(std::nullopt);
+      AppendCtlOut("ok unfollow\n");
+      break;
+    default:
+      AppendCtlOut(gxc::RunMemoryCommand(cmd, mem, bridge.MailboxAddress()));
+      break;
+    }
+  }
+}
+
+u64 NowMs()
+{
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+}
+
+
+std::mutex s_mutex;
+std::unique_ptr<State> s_state;
+
+bool ModAlive(const gxc::Shm& shm)
+{
+  const u64 hb = shm.GetU64(offsetof(GxcHeader, mod_heartbeat_ms));
+  return hb != 0 && NowMs() - hb < GXC_HEARTBEAT_TIMEOUT_MS;
+}
+
+// Keyboard and mouse are Minecraft's: the link is on, or its menus cover the game.
+bool MinecraftHasInput(const State& state)
+{
+  return (state.bridge->MinecraftMode() || state.bridge->InMenu()) && ModAlive(*state.shm);
+}
+
+// After the mode changes (hotkey, ctl link or a save picked): nothing held across the switch,
+// neither in Minecraft nor on the Wii Remote, and a message on screen. Under s_mutex.
+void AnnounceLink(State& state)
+{
+  const bool on = state.bridge->MinecraftMode();
+  if (on == state.link_shown)
+    return;
+  state.link_shown = on;
+  state.input->ReleaseAll();
+  state.mario.Reset();
+  std::memset(state.keys, 0, sizeof(state.keys));
+  state.buttons = 0;
+  s_xinput_buttons = 0;
+  NOTICE_LOG_FMT(CORE, "GalaxyCraft: link {}", on ? "on" : "off");
+  OSD::AddMessage(on ? "GalaxyCraft: Minecraft has the controls" :
+                       "GalaxyCraft: Wii Remote has the controls (Minecraft paused)",
+                  3000);
+}
